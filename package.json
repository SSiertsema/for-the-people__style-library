{
  "name": "@pzh-temporary/style-library",
  "private": false,
  "version": "1.2.12",
  "type": "module",
  "scripts": {
    "generate-variables": "node workflow/VariableGenereration/generateColors.cjs && node workflow/VariableGenereration/generateBoxShadows.cjs && node workflow/VariableGenereration/generateRadii.cjs && node workflow/VariableGenereration/generateSpacers.cjs && node workflow/VariableGenereration/generateSpacingUtilityClasses.cjs",
    "dev": "npm run generate-variables && storybook dev -p 1111",
    "build": "npm run generate-variables && storybook build",
    "publish-all": "npm run generate-variables && npm publish && node ./workflow/DeploymentCDN/preprocessUtilityClasses.cjs && node ./workflow/DeploymentCDN/deployUtilityClassesToCDN.cjs",
    "process-utility-classes": "node ./workflow/DeploymentCDN/preprocessUtilityClasses.cjs",
    "deploy-utility-classes": "node ./workflow/DeploymentCDN/deployUtilityClassesToCDN.cjs",
    "docs:dev": "npm run generate-variables && npm --prefix server run dev",
    "docs:build": "npm run generate-variables && npm --prefix server run build",
    "docs:preview": "npm --prefix server run preview"
  },
  "devDependencies": {
    "@azure/storage-blob": "^12.16.0",
    "@storybook/addon-designs": "^8.0.3",
    "@storybook/addon-essentials": "^8.2.6",
    "@storybook/addon-interactions": "^8.2.6",
    "@storybook/addon-links": "^8.2.6",
    "@storybook/addon-mdx-gfm": "^8.2.6",
    "@storybook/blocks": "^8.2.6",
    "@storybook/testing-library": "^0.2.1",
    "@storybook/vue3": "^8.2.6",
    "@storybook/vue3-vite": "^8.2.6",
    "@vitejs/plugin-vue": "^4.2.3",
    "basic-ftp": "^5.0.3",
    "consola": "^3.2.3",
    "dotenv": "^16.4.5",
    "glob-promise": "^6.0.7",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.64.2",
    "storybook": "^8.2.6",
    "uglifycss": "^0.0.29",
    "vite": "^4.4.5",
    "vue": "^3.5.0"
  }
}
