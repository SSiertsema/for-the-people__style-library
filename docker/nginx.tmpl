map ${ESC}sent_http_content_type ${ESC}expires {
    "text/html"                 epoch;
    "text/html; charset=utf-8"  epoch;
    default                     off;
}

server {
  listen 80 default_server;
  listen [::]:80 default_server;
  client_max_body_size 512M;
  server_tokens off;

  # Remove 'unsafe-inline' CSP after investigation of building Nuxt with no-unsafe-inline
  add_header Content-Security-Policy "default-src 'self' cdn-pzh.azureedge.net; font-src 'self' data: cdn-pzh.azureedge.net pzhcdnstorage.blob.core.windows.net; img-src 'self' data: *.zuid-holland.nl *.pdok.nl cdn-pzh.azureedge.net; connect-src 'self' dc.services.visualstudio.com *.zuid-holland.nl login.microsoftonline.com; object-src 'none'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' cdn-pzh.azureedge.net 'unsafe-inline'; script-src 'self'; script-src-elem 'self' js.monitor.azure.com alcdn.msauth.net alcdn.msftauth.net cdn-pzh.azureedge.net 'unsafe-inline';";
  add_header Strict-Transport-Security "max-age=31536000";
  add_header X-Frame-Options "SAMEORIGIN";
  add_header X-Content-Type-Options "nosniff";
  add_header Referrer-Policy "no-referrer";
  add_header Permissions-Policy "geolocation=()";

  root /webroot;

  # Reverse Proxy to Nuxt Server on port 3000
  location / {
        expires ${ESC}expires;

        proxy_redirect                      off;
        proxy_set_header Host               ${ESC}host;
        proxy_set_header X-Real-IP          ${ESC}remote_addr;
        proxy_set_header X-Forwarded-For    ${ESC}proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  ${ESC}scheme;
        proxy_read_timeout          1m;
        proxy_connect_timeout       1m;
        proxy_pass                          http://127.0.0.1:3000;
    }
}